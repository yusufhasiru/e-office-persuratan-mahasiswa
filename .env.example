# ---------------------------------------------------------------------------
# Konfigurasi aplikasi e-Office (contoh). Salin menjadi .env lalu sesuaikan.
# JANGAN menaruh nilai rahasia produksi pada file contoh ini.
# ---------------------------------------------------------------------------

# Server
PORT=3000
NODE_ENV=development
# URL publik aplikasi (dipakai untuk link QR Code verifikasi pada PDF)
BASE_URL=http://localhost:3000

# Wajib diisi saat NODE_ENV=production. Buat nilai acak:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=
SESSION_NAME=eoffice.sid
SESSION_TTL_HOURS=8
TRUST_PROXY=false

# Database SQLite & penyimpanan dokumen (relatif terhadap root project)
DATABASE_PATH=database/e-office.sqlite
STORAGE_PATH=storage/documents

# Batas waktu revisi (hari kalender)
REVISION_DEADLINE_DAYS=3

# Rate limit login per alamat IP (produksi memakai nilai ketat secara bawaan)
LOGIN_RATE_LIMIT_MAX=20
LOGIN_RATE_LIMIT_WINDOW_MINUTES=10

# Seeder: hanya untuk development. Pada NODE_ENV=production seeder tidak berjalan
# kecuali dijalankan dengan flag --force.
SEED_DEMO_PASSWORDS=true

# Identitas institusi pada kop surat PDF
INSTITUTION_NAME=Universitas Contoh Nusantara
FACULTY_NAME=Fakultas Teknik
DEPARTMENT_NAME=Jurusan Teknik Informatika
INSTITUTION_ADDRESS=Jl. Pendidikan No. 1, Kota Contoh 40111
